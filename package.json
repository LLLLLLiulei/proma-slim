{
  "name": "proma",
  "version": "0.1.0",
  "description": "The next gen ai software with general agents",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/ui",
    "packages/page-builder-cms-rendering",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@proma/app' dev",
    "dev:page-builder": "bun run --filter='@proma/page-builder' dev",
    "build": "bun run --filter='@proma/app' build",
    "start": "bun run --filter='@proma/app' start",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1"
  }
}
