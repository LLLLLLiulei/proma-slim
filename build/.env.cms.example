# CMS 集成模式示例配置
#
# 生产 / 联调使用方式：
#   docker compose --env-file build/.env.cms.example -f build/docker-compose.yml up -d --build server playwright web
#   ./build/start-page-builder.sh --env-file build/.env.cms.example
#
# 本地 CMS mock 验证使用方式：
#   docker compose --env-file build/.env.cms.example -f build/docker-compose.cms-verify.yml up -d --build server playwright web cms-mock nginx
#
# CMS 集成模式特点：
# - PageBuilder 首页会被门禁拦截，提示从 CMS 系统进入。
# - CMS 后端需要调用 PageBuilder 集成 API 创建 project binding 和 handoff。
# - 浏览器必须通过 handoff openUrl 进入 builder / preview。
# - server 和 web 的 AI_PAGE_BUILDER_BASE_PATH 必须一致。
#
# 注意：
# - 本文件当前包含本地真实示例值，提交前请确认是否允许进入版本库。
# - AI_PAGE_BUILDER_PUBLIC_ORIGIN 必须和浏览器实际访问的协议、域名、端口一致。
# - AI_PAGE_BUILDER_PUBLIC_ORIGIN 只能是 origin，不能带 /pagebuilder 这类 path。
# - 如果 public origin 配错，handoff openUrl 会跨 origin，iframe 场景会被 frame-ancestors 'self' 拦截。

# =============================================================================
# 1. 大模型配置（必填）
# =============================================================================

# Agent 调用上游大模型接口使用的密钥。
AI_PAGE_BUILDER_ANTHROPIC_API_KEY=sk-7e74dc1d51a14ae085119d8a5e5737c3

# Anthropic 兼容接口地址。留空时使用 SDK 默认地址。
# 示例：
#   AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
#   AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic


# =============================================================================
# 2. Web 端口、base path 与公开访问地址
# =============================================================================

# 宿主机访问 PageBuilder Web 的端口。
# 如果通过独立 compose 暴露 web，默认访问端口是 3333。
# 如果通过外部 Nginx / CMS 网关统一入口，生产环境通常不会直接暴露该端口给最终用户。
PAGE_BUILDER_PORT=3333

# 宿主机持久化数据目录。
# server 和 playwright 会共同挂载该目录到容器内 /home/bun/.ai-page-builder。
# 该目录保存 Agent 工作空间、SDK 配置和运行数据，两个服务必须使用同一个目录。
# 生产环境可改为 /data/ai-page-builder、/opt/ai-page-builder/data 等稳定持久化路径。
AI_PAGE_BUILDER_HOST_DATA_DIR=/Users/liu/.ai-page-builder

# PageBuilder 对外访问路径前缀。
# CMS 集成模式通常部署在子路径下，例如 /pagebuilder。
# 支持多级路径，例如 /ai/pagebuilder。
AI_PAGE_BUILDER_BASE_PATH=/pagebuilder

# 浏览器可访问的 PageBuilder 公开 origin。
# 只能配置 origin，不能包含 path。
#
# 正确示例：
#   AI_PAGE_BUILDER_PUBLIC_ORIGIN=https://builder.example.com
#   AI_PAGE_BUILDER_PUBLIC_ORIGIN=http://localhost.var123.cn:8088
#
# 错误示例：
#   AI_PAGE_BUILDER_PUBLIC_ORIGIN=https://builder.example.com/pagebuilder
AI_PAGE_BUILDER_PUBLIC_ORIGIN=http://localhost.var123.cn:3333


# =============================================================================
# 3. CMS 集成开关与服务端鉴权
# =============================================================================

# 必须设置为 cms，启用 CMS 集成模式。
AI_PAGE_BUILDER_INTEGRATION_MODE=cms

# CMS 与 PageBuilder server 之间共享的服务端密钥。
# CMS 调用集成 API 时需要通过 Authorization: Bearer <secret> 传入。
AI_PAGE_BUILDER_INTEGRATION_SECRET=5014796a21551dfe12be292a2bfe65f0dde4a2daab1c4c0cda2dc4cd2aa6897a

# CMS manager 后台地址，必须以 /manager 结尾。
# PageBuilder server 会用它校验 CMS cookie 登录态、拉取 CMS 数据和代理 CMS 资源。
#
# 生产示例：
#   AI_PAGE_BUILDER_CMS_BASE_URL=https://cms.example.com/manager
#
# 本地 cms-verify compose 会覆盖为 http://nginx:8080/manager。
AI_PAGE_BUILDER_CMS_BASE_URL=https://cms.work.zving.com/manager

# CMS 登录账号。PageBuilder server 会用它访问 CMS 管理接口。
AI_PAGE_BUILDER_CMS_USERNAME=admin
AI_PAGE_BUILDER_CMS_PASSWORD=zving10301


# =============================================================================
# 4. CMS handoff / access session / export 参数
# =============================================================================

# CMS handoff URL 的有效期，单位毫秒。默认 120000，即 2 分钟。
AI_PAGE_BUILDER_HANDOFF_TTL_MS=120000

# CMS access session 的有效期，单位毫秒。默认 28800000，即 8 小时。
AI_PAGE_BUILDER_ACCESS_SESSION_TTL_MS=28800000

# CMS 同步导出接口的服务端超时，单位毫秒。
# 建议按生产 SLA 配置，例如 30000。
AI_PAGE_BUILDER_SYNC_EXPORT_TIMEOUT_MS=30000


# =============================================================================
# 5. Playwright MCP sidecar
# =============================================================================

# PageBuilder server 在 Docker 内访问 Playwright MCP 的地址。
# 默认 docker-compose.yml 会启动 playwright sidecar，通常不需要改。
AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=http://playwright:8931/mcp

# PageBuilder server 在 Docker 内访问自身 API / preview 的内部 origin。
# 默认使用 compose service name，通常不需要改。
AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=http://server:8888


# =============================================================================
# 6. 本地 CMS mock 验证专用变量（仅 docker-compose.cms-verify.yml 使用）
# =============================================================================

# 宿主机访问 CMS verify nginx 的端口。
# 默认入口：
#   http://localhost:8088/cms-mock/
#   http://localhost:8088/pagebuilder/
CMS_VERIFY_PORT=8088

# CMS verify 模式下的浏览器公开 origin。
# 必须和你实际打开的域名、端口一致。
#
# 如果使用 localhost：
#   CMS_VERIFY_PUBLIC_ORIGIN=http://localhost:8088
#
# 如果使用本地域名：
#   CMS_VERIFY_PUBLIC_ORIGIN=http://localhost.var123.cn:8088
CMS_VERIFY_PUBLIC_ORIGIN=http://localhost.var123.cn:8088

# CMS mock 用于模拟 CMS 登录态的 cookie。
# 可以替换为真实联调 cookie。
#
# 示例：
#   CMS_VERIFY_COOKIE="_CurrentSite=1; ZUSID=your_cookie_value"
CMS_VERIFY_COOKIE="_CurrentSite=1; ZUSID=bN6BguFbQJ612P4iH93Vaw"
