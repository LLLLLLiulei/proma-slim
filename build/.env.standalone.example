# 独立运行模式示例配置
#
# 使用方式：
#   docker compose --env-file build/.env.standalone.example -f build/docker-compose.yml up -d --build server playwright web
#   ./build/start-page-builder.sh
#
# 独立模式特点：
# - PageBuilder 首页直接展示输入框和历史记录。
# - 不要求从 CMS handoff 入口进入。
# - 不校验 CMS access session。
# - CMS 相关变量保持为空即可。
#
# 注意：
# - 本文件当前包含本地真实示例值，提交前请确认是否允许进入版本库。
# - 如果通过 Nginx 以子路径部署，请同步设置 AI_PAGE_BUILDER_BASE_PATH，并确保 Nginx location 与该路径一致。

# =============================================================================
# 1. Agent SDK / 大模型配置
# =============================================================================

# 推荐直接使用 Claude Code / Agent SDK 官方环境变量名。
# DeepSeek Anthropic-compatible 示例：
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_AUTO_COMPACT_WINDOW=1000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
API_TIMEOUT_MS=3000000

# 兼容旧配置：仅当上方官方 ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL 未设置时作为 fallback。
AI_PAGE_BUILDER_ANTHROPIC_API_KEY=
AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=

# 如需使用其他 Anthropic-compatible provider，可调整 ANTHROPIC_BASE_URL 与模型名；
# 如果 provider 要求 Bearer token，填写 ANTHROPIC_AUTH_TOKEN 即可，不必再填写 ANTHROPIC_API_KEY。


# =============================================================================
# 2. Web 端口与访问路径
# =============================================================================

# 宿主机访问 PageBuilder Web 的端口。
# 默认访问：http://localhost:3333/
PAGE_BUILDER_PORT=3333

# 宿主机持久化数据目录。
# server 和 playwright 会共同挂载该目录到容器内 /home/bun/.ai-page-builder。
# 该目录保存 Agent 工作空间、SDK 配置和运行数据，两个服务必须使用同一个目录。
# 生产环境可改为 /data/ai-page-builder、/opt/ai-page-builder/data 等稳定持久化路径。
AI_PAGE_BUILDER_HOST_DATA_DIR=/Users/liu/.ai-page-builder

# PageBuilder 对外访问路径前缀。
# - 根路径部署：留空。
# - 子路径部署：设置为 /pagebuilder、/ai/pagebuilder 等。
# - server 和 web 会通过 docker-compose.yml 使用同一个值。
#
# 根路径示例：
#   AI_PAGE_BUILDER_BASE_PATH=
#
# 子路径示例：
#   AI_PAGE_BUILDER_BASE_PATH=/pagebuilder
#
# 多级子路径示例：
#   AI_PAGE_BUILDER_BASE_PATH=/ai/pagebuilder
AI_PAGE_BUILDER_BASE_PATH=

# Builder 工作台工具栏隐藏项，逗号分隔。留空表示全部展示。
# 支持：pcPreview,mobilePreview,select,refresh,openInNewWindow,export,saveTemplate,chatTab,codeTab,projectName
# 对应中文：pcPreview=PC 预览，mobilePreview=Mobile 预览，select=选择，refresh=刷新，openInNewWindow=新窗口打开，
#           export=导出，saveTemplate=另存模板，chatTab=对话，codeTab=代码，projectName=项目名称
# 示例：AI_PAGE_BUILDER_HIDDEN_TOOLBAR_ITEMS=export,saveTemplate,projectName
AI_PAGE_BUILDER_HIDDEN_TOOLBAR_ITEMS=


# =============================================================================
# 3. 独立模式开关
# =============================================================================

# 留空即为 standalone 独立模式。
AI_PAGE_BUILDER_INTEGRATION_MODE=

# 独立模式不需要 CMS 服务端密钥。
AI_PAGE_BUILDER_INTEGRATION_SECRET=

# 独立模式不需要 CMS 后台地址。
AI_PAGE_BUILDER_CMS_BASE_URL=

# 独立模式不需要 public origin 生成 CMS handoff。
AI_PAGE_BUILDER_PUBLIC_ORIGIN=

# 独立模式不使用 CMS handoff / access session。
AI_PAGE_BUILDER_HANDOFF_TTL_MS=
AI_PAGE_BUILDER_ACCESS_SESSION_TTL_MS=
AI_PAGE_BUILDER_ACCESS_SESSION_RENEW_THRESHOLD_MS=

# 独立模式没有 CMS 同步导出服务端超时要求，0 表示不设置服务端超时。
AI_PAGE_BUILDER_SYNC_EXPORT_TIMEOUT_MS=0

# 独立模式不需要 CMS 登录账号。
AI_PAGE_BUILDER_CMS_USERNAME=
AI_PAGE_BUILDER_CMS_PASSWORD=


# =============================================================================
# 4. 模板导入参数
# =============================================================================

# 模板 ZIP 导入原始文件大小上限，单位 MB。默认 100。
AI_PAGE_BUILDER_TEMPLATE_IMPORT_MAX_ZIP_MB=100

# 模板 ZIP 解压后累计文件大小上限，单位 MB。默认 500。
AI_PAGE_BUILDER_TEMPLATE_IMPORT_MAX_UNCOMPRESSED_MB=500


# =============================================================================
# 5. 图片搜索平台配置
# =============================================================================

# 图片搜索 MCP 使用平台原生环境变量名配置 API Key。
# 启用的图片搜索平台白名单。默认只启用 pexels,pixabay；如需启用其他平台可配置为 pexels,pixabay,unsplash,bing。
IMAGE_SEARCH_PROVIDERS=pexels,pixabay
PEXELS_API_KEY=N77SresXtOoWI6EGqlSCAzGgu31qHP1MkfYt8AGQDqbdQwARgb60fssp
PIXABAY_API_KEY=55909511-862b00a6c4cbade02d40aa1e3
UNSPLASH_ACCESS_KEY=wBw0_G2cO_JJepyvc20GPcptZQrR56TCYGuszOABFtk

# =============================================================================
# 6. Playwright MCP sidecar
# =============================================================================

# PageBuilder server 在 Docker 内访问 Playwright MCP 的地址。
# 默认 docker-compose.yml 会启动 playwright sidecar，通常不需要改。
AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=http://playwright:8931/mcp

# PageBuilder server 在 Docker 内访问自身 API / preview 的内部 origin。
# 默认使用 compose service name，通常不需要改。
# 该值仅用于 Agent / Playwright sidecar 在 Docker 内访问只读预览。
# 不要配置为浏览器 public origin、外部域名或 AI_PAGE_BUILDER_PUBLIC_ORIGIN。
AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=http://server:8888
