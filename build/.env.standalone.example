# 独立运行模式示例配置
#
# 使用方式：
#   docker compose --env-file build/.env.standalone.example -f build/docker-compose.yml up -d --build server playwright web
#   ./build/start-page-builder.sh
#
# 独立模式特点：
# - PageBuilder 首页直接展示输入框和历史记录。
# - 不要求从 CMS handoff 入口进入。
# - 不校验 CMS access session。
# - CMS 相关变量保持为空即可。
#
# 注意：
# - 本文件当前包含本地真实示例值，提交前请确认是否允许进入版本库。
# - 如果通过 Nginx 以子路径部署，请同步设置 AI_PAGE_BUILDER_BASE_PATH，并确保 Nginx location 与该路径一致。

# =============================================================================
# 1. 大模型配置（必填）
# =============================================================================

# Agent 调用上游大模型接口使用的密钥。
AI_PAGE_BUILDER_ANTHROPIC_API_KEY=sk-7e74dc1d51a14ae085119d8a5e5737c3

# Anthropic 兼容接口地址。留空时使用 SDK 默认地址。
# 示例：
#   AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
#   AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
AI_PAGE_BUILDER_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic


# =============================================================================
# 2. Web 端口与访问路径
# =============================================================================

# 宿主机访问 PageBuilder Web 的端口。
# 默认访问：http://localhost:3333/
PAGE_BUILDER_PORT=3333

# 宿主机持久化数据目录。
# server 和 playwright 会共同挂载该目录到容器内 /home/bun/.ai-page-builder。
# 该目录保存 Agent 工作空间、SDK 配置和运行数据，两个服务必须使用同一个目录。
# 生产环境可改为 /data/ai-page-builder、/opt/ai-page-builder/data 等稳定持久化路径。
AI_PAGE_BUILDER_HOST_DATA_DIR=/Users/liu/.ai-page-builder

# PageBuilder 对外访问路径前缀。
# - 根路径部署：留空。
# - 子路径部署：设置为 /pagebuilder、/ai/pagebuilder 等。
# - server 和 web 会通过 docker-compose.yml 使用同一个值。
#
# 根路径示例：
#   AI_PAGE_BUILDER_BASE_PATH=
#
# 子路径示例：
#   AI_PAGE_BUILDER_BASE_PATH=/pagebuilder
#
# 多级子路径示例：
#   AI_PAGE_BUILDER_BASE_PATH=/ai/pagebuilder
AI_PAGE_BUILDER_BASE_PATH=


# =============================================================================
# 3. 独立模式开关
# =============================================================================

# 留空即为 standalone 独立模式。
AI_PAGE_BUILDER_INTEGRATION_MODE=

# 独立模式不需要 CMS 服务端密钥。
AI_PAGE_BUILDER_INTEGRATION_SECRET=

# 独立模式不需要 CMS 后台地址。
AI_PAGE_BUILDER_CMS_BASE_URL=

# 独立模式不需要 public origin 生成 CMS handoff。
AI_PAGE_BUILDER_PUBLIC_ORIGIN=

# 独立模式不使用 CMS handoff / access session。
AI_PAGE_BUILDER_HANDOFF_TTL_MS=
AI_PAGE_BUILDER_ACCESS_SESSION_TTL_MS=

# 独立模式没有 CMS 同步导出服务端超时要求，0 表示不设置服务端超时。
AI_PAGE_BUILDER_SYNC_EXPORT_TIMEOUT_MS=0

# 独立模式不需要 CMS 登录账号。
AI_PAGE_BUILDER_CMS_USERNAME=
AI_PAGE_BUILDER_CMS_PASSWORD=


# =============================================================================
# 4. Playwright MCP sidecar
# =============================================================================

# PageBuilder server 在 Docker 内访问 Playwright MCP 的地址。
# 默认 docker-compose.yml 会启动 playwright sidecar，通常不需要改。
AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=http://playwright:8931/mcp

# PageBuilder server 在 Docker 内访问自身 API / preview 的内部 origin。
# 默认使用 compose service name，通常不需要改。
AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=http://server:8888
