# Copy this file to build/.env before running:
# docker compose --env-file build/.env -f build/docker-compose.yml up --build

# Required
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional
ANTHROPIC_BASE_URL=
PAGE_BUILDER_PORT=3333
AI_PAGE_BUILDER_CMS_BASE_URL=
AI_PAGE_BUILDER_CMS_ZUSID=
AI_PAGE_BUILDER_CMS_CURRENT_SITE=
AI_PAGE_BUILDER_CMS_REFERER=

# Enable the optional playwright sidecar with:
# docker compose --profile playwright --env-file build/.env -f build/docker-compose.yml up --build
# When enabled, set:
# AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=http://playwright:8931/mcp
# AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=http://server:8888
AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=
AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=
