# Copy this file to build/.env before running:
# docker compose --env-file build/.env -f build/docker-compose.yml up --build

# Required
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional
ANTHROPIC_BASE_URL=
PAGE_BUILDER_PORT=3333

# Optional public browser-facing base path for PageBuilder, for example /pagebuilder.
# Leave empty for standalone root mode.
# In production, Nginx or CMS gateway should strip this prefix before proxying to PageBuilder Web.
AI_PAGE_BUILDER_BASE_PATH=

# Optional CMS server-to-server integration mode.
# Set AI_PAGE_BUILDER_INTEGRATION_MODE=cms only when PageBuilder is embedded by CMS.
AI_PAGE_BUILDER_INTEGRATION_MODE=
AI_PAGE_BUILDER_INTEGRATION_SECRET=
# CMS manager base URL used only for /ui/login cookie validation, for example https://cms.example.com/manager.
AI_PAGE_BUILDER_CMS_BASE_URL=
# Browser-facing PageBuilder origin used to generate CMS handoff openUrl. Must be an origin only, for example https://builder.example.com.
AI_PAGE_BUILDER_PUBLIC_ORIGIN=
# Optional CMS handoff and PageBuilder access session TTL overrides in milliseconds.
AI_PAGE_BUILDER_HANDOFF_TTL_MS=
AI_PAGE_BUILDER_ACCESS_SESSION_TTL_MS=
# Optional PageBuilder-side synchronous CMS export timeout in milliseconds. 0 means no server-side timeout.
AI_PAGE_BUILDER_SYNC_EXPORT_TIMEOUT_MS=0
AI_PAGE_BUILDER_CMS_USERNAME=
AI_PAGE_BUILDER_CMS_PASSWORD=

# Playwright sidecar is enabled by default.
# Override these only when you need a different MCP endpoint or internal app origin:
# AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=http://playwright:8931/mcp
# AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=http://server:8888
AI_PAGE_BUILDER_PLAYWRIGHT_MCP_URL=
AI_PAGE_BUILDER_INTERNAL_APP_ORIGIN=

# Optional local CMS integration verification stack.
# Used only with docker-compose.cms-verify.yml.
CMS_VERIFY_PORT=8088
CMS_VERIFY_PUBLIC_ORIGIN=http://localhost:8088
CMS_VERIFY_COOKIE="CurrentSite=1; ZUSID=cms-verify"
