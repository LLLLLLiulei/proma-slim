# PageBuilder MCP Server standalone Docker configuration.
# Copy this file outside the repository and fill real provider secrets there.

# ---------------------------------------------------------------------------
# HTTP MCP runtime
# ---------------------------------------------------------------------------

PAGEBUILDER_MCP_HOST=0.0.0.0
PAGEBUILDER_MCP_PORT=3000
PAGEBUILDER_MCP_PUBLISHED_PORT=3000
PAGEBUILDER_MCP_PATH=/mcp
PAGEBUILDER_MCP_LOG_PATH=

SERVER_NAME=pagebuilder-mcp-server
SERVER_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------

# Supported values: ZHIPU, ZAI, ALIYUN.
PLATFORM_MODE=ZHIPU

# ---------------------------------------------------------------------------
# ZHIPU / ZAI compatible provider
# ---------------------------------------------------------------------------

# Required when PLATFORM_MODE=ZHIPU or PLATFORM_MODE=ZAI.
# This is a provider compatibility variable, not the MCP service name.
Z_AI_API_KEY=

# Compatibility alias.
ZAI_API_KEY=

# Optional compatibility platform selector. Priority: PLATFORM_MODE > Z_AI_MODE.
Z_AI_MODE=

# Optional provider endpoint and model overrides.
Z_AI_BASE_URL=
Z_AI_VISION_MODEL=
Z_AI_IMAGE_MODEL=
Z_AI_IMAGE_SIZE=
Z_AI_TIMEOUT=
Z_AI_RETRY_COUNT=

# ---------------------------------------------------------------------------
# Alibaba Cloud / Qwen provider
# ---------------------------------------------------------------------------

# Required when PLATFORM_MODE=ALIYUN. One of these is enough.
# Priority: ALIYUN_API_KEY > QWEN_API_KEY > DASHSCOPE_API_KEY.
ALIYUN_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# Optional workspace-specific endpoint configuration.
ALIYUN_WORKSPACE_ID=
ALIYUN_REGION=

# Optional explicit endpoint overrides.
ALIYUN_OPENAI_BASE_URL=
ALIYUN_DASHSCOPE_BASE_URL=
ALIYUN_BASE_URL=
ALIYUN_NATIVE_BASE_URL=

# Optional Aliyun vision model configuration.
ALIYUN_VISION_MODEL=
ALIYUN_VISION_MODEL_TEMPERATURE=
ALIYUN_VISION_MODEL_TOP_P=
ALIYUN_VISION_MODEL_MAX_TOKENS=
ALIYUN_ENABLE_THINKING=
ALIYUN_THINKING_BUDGET=
ALIYUN_VL_HIGH_RESOLUTION_IMAGES=
ALIYUN_MAX_PIXELS=

# Optional Aliyun image generation configuration.
ALIYUN_IMAGE_MODEL=
ALIYUN_IMAGE_SIZE=
ALIYUN_IMAGE_PROMPT_EXTEND=
ALIYUN_IMAGE_WATERMARK=
ALIYUN_IMAGE_NEGATIVE_PROMPT=
ALIYUN_TIMEOUT=
ALIYUN_RETRY_COUNT=
