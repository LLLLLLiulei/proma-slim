FROM oven/bun:1.2.5 AS deps
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY apps/app/package.json apps/app/package.json
COPY apps/page-builder/package.json apps/page-builder/package.json
COPY packages/cms-vue-islands-demo/package.json packages/cms-vue-islands-demo/package.json
COPY packages/page-builder-cms-rendering/package.json packages/page-builder-cms-rendering/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN bun install --frozen-lockfile --network-concurrency=8 --concurrent-scripts=2

FROM deps AS build
WORKDIR /app

COPY . .

RUN bun run --filter='@ai-page-builder/app' build
RUN bun apps/app/scripts/build-server-runtime-assets.ts /app/apps/app/dist-server
RUN bun build apps/app/src/main/index.ts \
  --target=node \
  --format=esm \
  --external sharp \
  --external @anthropic-ai/claude-agent-sdk \
  --external node-stream-zip \
  --external vue \
  --outfile /app/apps/app/src/main/index.mjs

FROM node:22-bookworm-slim AS runtime
USER root
ARG DEBIAN_MIRROR=
ARG DEBIAN_SECURITY_MIRROR=
RUN set -eux; \
  if [ -n "${DEBIAN_MIRROR}" ]; then \
    sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
  fi; \
  if [ -n "${DEBIAN_SECURITY_MIRROR}" ]; then \
    sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
  fi; \
  for attempt in 1 2 3 4 5; do \
    apt-get update -o Acquire::Retries=5 \
      && apt-get install -y --no-install-recommends -o Acquire::Retries=5 ca-certificates git \
      && break; \
    if [ "${attempt}" = "5" ]; then exit 1; fi; \
    rm -rf /var/lib/apt/lists/*; \
    sleep $((attempt * 2)); \
  done; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/bun.lock ./bun.lock
COPY --from=build /app/tsconfig.json ./tsconfig.json
COPY --from=build /app/packages/page-builder-cms-rendering ./packages/page-builder-cms-rendering
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/packages/ui ./packages/ui
COPY --from=build /app/apps/app ./apps/app

RUN mkdir -p /home/bun/.ai-page-builder

ENV NODE_ENV=production
ENV PORT=8888
ENV AI_PAGE_BUILDER_CONFIG_DIR=/home/bun/.ai-page-builder
ENV AI_PAGE_BUILDER_SDK_HOME=/home/bun/.ai-page-builder/sdk-config
ENV PROMA_DEFAULT_SKILLS_DIR=/app/apps/app/default-skills
ENV PROMA_WORKSPACE_TEMPLATES_DIR=/app/apps/app/resources/templates
ENV PROMA_PAGE_BUILDER_PREVIEW_BRIDGE_PATH=/app/apps/app/dist-server/page-builder-preview-bridge.js
ENV PROMA_PAGE_BUILDER_CMS_RENDERING_PREVIEW_PATH=/app/apps/app/dist-server/cms-rendering-preview.js
ENV PROMA_PAGE_BUILDER_CMS_RENDERING_VUE_PATH=/app/node_modules/vue/dist/vue.esm-browser.prod.js

WORKDIR /app/apps/app

EXPOSE 8888

CMD ["sh", "-lc", "PROMA_CONFIG_DIR=\"${AI_PAGE_BUILDER_CONFIG_DIR:-/home/bun/.ai-page-builder}\" PROMA_CLAUDE_HOME=\"${AI_PAGE_BUILDER_SDK_HOME:-/home/bun/.ai-page-builder/sdk-config}\" PROMA_CMS_BASE_URL=\"${AI_PAGE_BUILDER_CMS_BASE_URL:-}\" PROMA_CMS_USERNAME=\"${AI_PAGE_BUILDER_CMS_USERNAME:-}\" PROMA_CMS_PASSWORD=\"${AI_PAGE_BUILDER_CMS_PASSWORD:-}\" exec node src/main/index.mjs"]
