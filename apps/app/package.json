{
  "name": "@ai-page-builder/app",
  "version": "0.7.1",
  "description": "AI Page Builder minimal Claude Code web app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c blue,green \"bun run dev:vite\" \"bun run dev:server\"",
    "dev:split": "bash scripts/dev-split.sh",
    "dev:vite": "vite dev",
    "dev:server": "PROMA_CONFIG_DIR=\"${PROMA_CONFIG_DIR:-$HOME/.proma-dev}\" NODE_ENV=development bun scripts/dev-server.ts --entry src/main/index.ts --log-name app-server.log",
    "build": "NODE_ENV=production vite build",
    "build:renderer": "vite build",
    "start": "NODE_ENV=production bun src/main/index.ts",
    "typecheck": "tsc --noEmit",
    "generate:icons": "cd resources && ./generate-icons.sh",
    "build:vendor": "bun run scripts/download-bun.ts",
    "build:vendor:current": "bun run scripts/download-bun.ts --platform $(node -p \"process.platform + '-' + process.arch\")"
  },
  "dependencies": {
    "@ai-page-builder/page-builder-cms-rendering": "workspace:*",
    "@ai-page-builder/shared": "workspace:*",
    "@ai-page-builder/ui": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.2.76",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hono/node-server": "^2.0.6",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rc-component/tree": "^1.3.1",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-mention": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/suggestion": "^3.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "hono": "^4.12.8",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.16",
    "linkedom": "^0.18.12",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "node-stream-zip": "^1.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "undici": "^7.21.0",
    "unstorage": "^1.17.5",
    "use-stick-to-bottom": "^1.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "proma": {
    "bun": {
      "version": "1.2.5"
    }
  }
}
