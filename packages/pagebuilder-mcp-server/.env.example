# ---------------------------------------------------------------------------
# PageBuilder MCP Server runtime
# ---------------------------------------------------------------------------

# HTTP MCP service bind address and endpoint.
PAGEBUILDER_MCP_HOST=0.0.0.0
PAGEBUILDER_MCP_PORT=3000
PAGEBUILDER_MCP_PATH=/mcp

# Optional log file path. If empty, logs are written under the current user's
# ~/.pagebuilder-mcp-server directory. Stdio protocol output remains on stdout.
PAGEBUILDER_MCP_LOG_PATH=

# Optional MCP server identity overrides.
SERVER_NAME=pagebuilder-mcp-server
SERVER_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------

# Supported values:
# - ZHIPU: Zhipu BigModel compatible API, default
# - ZAI: ZAI platform compatible API
# - ALIYUN: Alibaba Cloud DashScope / Qwen
PLATFORM_MODE=ZHIPU

# ---------------------------------------------------------------------------
# ZHIPU / ZAI compatible provider configuration
# ---------------------------------------------------------------------------

# Required when PLATFORM_MODE=ZHIPU or PLATFORM_MODE=ZAI.
# This is a provider compatibility variable, not the service name.
Z_AI_API_KEY=sk-your-zhipu-or-zai-key

# Compatibility alias. Used only when Z_AI_API_KEY is not set.
# ZAI_API_KEY=sk-your-zai-key

# Optional compatibility platform selector. Priority: PLATFORM_MODE > Z_AI_MODE.
# Z_AI_MODE=ZHIPU

# Optional provider base URL override.
# ZHIPU default: https://open.bigmodel.cn/api/paas/v4/
# ZAI default: https://api.z.ai/api/paas/v4/
# Z_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Optional model overrides.
# Z_AI_VISION_MODEL=glm-4.6v
# Z_AI_IMAGE_MODEL=glm-image
# Z_AI_IMAGE_SIZE=1280x1280

# ---------------------------------------------------------------------------
# Alibaba Cloud / Qwen provider configuration
# ---------------------------------------------------------------------------

# Required when PLATFORM_MODE=ALIYUN. One of the following is enough.
# Priority: ALIYUN_API_KEY > QWEN_API_KEY > DASHSCOPE_API_KEY.
# ALIYUN_API_KEY=sk-your-aliyun-key
# QWEN_API_KEY=sk-your-qwen-key
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# Optional workspace-specific endpoint configuration.
# ALIYUN_WORKSPACE_ID=your-workspace-id
# ALIYUN_REGION=cn-beijing

# Optional explicit endpoint overrides.
# ALIYUN_OPENAI_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ALIYUN_DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# ALIYUN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com
# ALIYUN_NATIVE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1

# Optional Aliyun vision model configuration.
# ALIYUN_VISION_MODEL=qwen3-vl-plus
# ALIYUN_VISION_MODEL_TEMPERATURE=0.8
# ALIYUN_VISION_MODEL_TOP_P=0.6
# ALIYUN_VISION_MODEL_MAX_TOKENS=32768
# ALIYUN_ENABLE_THINKING=false
# ALIYUN_THINKING_BUDGET=81920
# ALIYUN_VL_HIGH_RESOLUTION_IMAGES=false
# ALIYUN_MAX_PIXELS=2621440

# Optional Aliyun image generation configuration.
# ALIYUN_IMAGE_MODEL=qwen-image-2.0-pro
# ALIYUN_IMAGE_SIZE=2048*2048
# ALIYUN_IMAGE_PROMPT_EXTEND=true
# ALIYUN_IMAGE_WATERMARK=false
# ALIYUN_IMAGE_NEGATIVE_PROMPT=

# ---------------------------------------------------------------------------
# Common provider tuning
# ---------------------------------------------------------------------------

# ALIYUN_TIMEOUT=300000
# ALIYUN_RETRY_COUNT=1
# Z_AI_TIMEOUT=300000
# Z_AI_RETRY_COUNT=1
